# Copy to .env, or just run `py scripts/dev.py up` which creates .env with random values for you.
# Never commit .env. These are placeholders, not real secrets.

POSTGRES_PASSWORD=change-me-postgres
SESSION_SECRET=change-me-session-secret-at-least-32-chars
ADMIN_TOKEN=change-me-admin-token
GRAFANA_PASSWORD=change-me-grafana

# Synthetic probe household used by the responder to check the shopping-list journey.
PROBE_EMAIL=probe@pantry-probe.com
PROBE_PASSWORD=change-me-probe-password

# Optional: lets the responder use Claude instead of its built-in playbook.
ANTHROPIC_API_KEY=
RESPONDER_MODEL=claude-sonnet-5-5

# Optional: lets the responder open a GitHub issue when it needs a human.
GITHUB_TOKEN=
GITHUB_REPOSITORY=thestronghearted/Pantry
