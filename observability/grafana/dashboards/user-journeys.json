{
  "uid": "pantry-journeys",
  "title": "User journeys",
  "tags": ["pantry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Shopping list success (5m, real users)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1, "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "orange", "value": 0.95 }, { "color": "green", "value": 0.995 } ] }
        }, "overrides": []
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ {
        "refId": "A",
        "expr": "1 - (sum(rate(journey_requests_total{journey=\"shopping_list\",outcome=\"error\",synthetic=\"false\"}[5m])) or vector(0)) / sum(rate(journey_requests_total{journey=\"shopping_list\",synthetic=\"false\"}[5m]))"
      } ]
    },
    {
      "id": 2, "type": "stat", "title": "Alerts firing",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Plan days off calorie target (1h)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "sum(increase(plan_days_off_target_total[1h])) or vector(0)" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Plans generated (1h)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "expr": "sum(increase(journey_requests_total{journey=\"generate_plan\",outcome=\"success\",synthetic=\"false\"}[1h])) or vector(0)" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Shopping list requests per second, by outcome",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } }, "overrides": [
        { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
        { "matcher": { "id": "byName", "options": "success" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] } ] },
      "targets": [ { "refId": "A", "legendFormat": "{{outcome}}", "expr": "sum by (outcome) (rate(journey_requests_total{journey=\"shopping_list\",synthetic=\"false\"}[1m]))" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Shopping list p95 latency (click a dot to open the trace)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(journey_duration_seconds_bucket{journey=\"shopping_list\"}[2m])))" },
        { "refId": "B", "legendFormat": "slow request", "exemplar": true, "expr": "histogram_quantile(0.95, sum by (le) (rate(journey_duration_seconds_bucket{journey=\"shopping_list\"}[2m])))" }
      ]
    },
    {
      "id": 7, "type": "logs", "title": "Errors from the API (each line has a trace_id)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [ { "refId": "A", "expr": "{service_name=\"pantry-api\"} | severity_text=\"ERROR\"" } ]
    }
  ]
}
